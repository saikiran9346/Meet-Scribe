# ==========================================
# MeetScribe - Backend Environment Variables
# ==========================================
# Copy this file to backend/.env and fill in your actual values

# Server Settings
PORT=8080
FRONTEND_URL=http://localhost:3000

# AI & Speech-to-Text Services
# Get Deepgram API key from: https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Get Groq API key from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Bot Mode (true for background headless, false to see the browser UI)
HEADLESS=true